LIT_MODE=cloud
LIT_PUBLIC_URL=https://lit.example.com
LIT_ALLOWED_HOSTS=lit.example.com
LIT_OIDC_ISSUER=https://your-oidc-provider.example.com
LIT_OIDC_CLIENT_ID=replace-me
LIT_OIDC_CLIENT_SECRET=replace-me
LIT_OWNER_SUBJECT=replace-with-fixed-subject
# Generate two DIFFERENT random secrets, each at least 32 bytes; keep outside backups.
LIT_SESSION_SECRET=replace-with-random-session-secret
LIT_TOKEN_SECRET=replace-with-different-random-token-secret
LIT_DATA_DIR=/opt/litworkbench/data
LIT_WORKER_ENABLED=false
WITH_OCR=false
LITWORKBENCH_MAX_UPLOAD_BYTES=104857600
